APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgres://rag:rag@localhost:5432/rag?sslmode=disable

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=document_chunks

OPENAI_API_KEY=replace-me
